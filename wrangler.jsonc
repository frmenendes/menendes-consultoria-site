{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menendes-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-17",
  // nodejs_compat é obrigatório para o adapter do Next rodar no Workers.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // Rate limit do formulário de contato (chave por IP, TTL curto).
      // ATENÇÃO: o id abaixo é um marcador. Antes do primeiro deploy, rodar
      //   wrangler kv namespace create RATE_LIMIT
      // e substituir pelo id retornado. Em execução local o miniflare cria um
      // namespace próprio e ignora este valor.
      "binding": "RATE_LIMIT",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "SITE_URL": "https://menendes.com.br"
  }
  // Secrets (nunca versionados, definir com `wrangler secret put`):
  //   RESEND_API_KEY  — chave da API do Resend
  //   CONTACT_TO      — e-mail que recebe as mensagens do formulário
  //   CONTACT_FROM    — remetente verificado no Resend
}

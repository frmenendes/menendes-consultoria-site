{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menendes-consultoria-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: qualquer rota desconhecida cai no index.html e o router do React
    // resolve (ou mostra o 404 da aplicação).
    "not_found_handling": "single-page-application",
    // Tudo passa pelo worker: security headers (CSP, HSTS) e o redirect
    // canônico www -> apex valem também para os assets estáticos.
    "run_worker_first": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menendes-consultoria-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-17",
  // nodejs_compat é obrigatório para o adapter do Next rodar no Workers.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Rate limit nativo do Workers para o formulário de contato.
  // Escolhido no lugar de KV justamente por não exigir a criação de um recurso
  // na conta: o namespace_id é um número arbitrário, não um id de namespace
  // real, então o deploy funciona sem passo manual anterior.
  // O período é limitado pela plataforma a 10 ou 60 segundos.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "SITE_URL": "https://menendes.com.br"
  }
  // Secrets (nunca versionados, definir com `wrangler secret put`):
  //   RESEND_API_KEY  — chave da API do Resend
  //   CONTACT_TO      — e-mail que recebe as mensagens do formulário
  //   CONTACT_FROM    — remetente verificado no Resend
  // Sem eles o endpoint responde 503 com mensagem orientando o visitante a
  // usar o e-mail do rodapé, em vez de falhar em silêncio.
}
